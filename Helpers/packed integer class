class pint {
public:
    using uint = uint8_t;

    pint() = default;
    explicit pint(const uint value) : numerals{value} { }

    [[nodiscard]] uint load (const size_t idx) const {
        //Full-Index function
        const auto v_idx = idx >> 3;
        const auto n_idx = idx & 0b111U;

        return (numerals.at(v_idx) >> (28 - 4*n_idx)) & 0b1111U;
    }

    [[nodiscard]] uint load (const uint& element, const size_t n_idx) const {
        //Range-based loop function
        return (element >> (28 - 4*n_idx)) & 0b1111U;
    }

    void store (const size_t idx, const uint value) {
        const auto v_idx = idx / 8;
        const auto n_idx = idx & 0b111U;

        //Strings can't be used at all. Cause they might overflow.
        auto result = numerals.at[v_idx]
    }

    void store (uint& element, const size_t n_idx, const uint value) {
        //Range-based loop function
        std::string ele_str = std::bitset<32>(element).to_string();
        const std::string val_str = std::bitset<4>(value).to_string();
        ele_str.replace(4*n_idx, 4, val_str);

        element = std::stoul(ele_str);
    }

    void print () const {
        std::string number {};
        for (const uint32_t& numeral: numerals)
            for (size_t idx = 0; idx < 8; idx++)
                number += std::to_string(load(numeral, idx));

        reverse(number.begin(), number.end());
        number.erase(0, number.find_first_not_of('0'));

        std::cout << number << "\n";
    }

private:
    std::vector<uint> numerals = {0b0001'0000'0000'0000'0000'0000'0000'0000U};
};